# MMM — Making Money Moves
# All keys are OPTIONAL. The AI coach graceful-degrades: with no key and no local
# model running, it returns a friendly "coach is temporarily unavailable" message.
# Copy this file to .env and fill in only what you want. Never commit .env.

# Claude (preferred when set) — used by the Advisor / coach.
ANTHROPIC_API_KEY=

# Coach model (defaults to claude-haiku-4-5-20251001 when ANTHROPIC_API_KEY is set).
MONEY_COACH_MODEL=

# Local Ollama fallback URL (defaults to http://localhost:11434).
OLLAMA_URL=

# Override the local model the coach uses (defaults per local-model-client roles).
# DESK_MODEL=qwen2.5:3b
