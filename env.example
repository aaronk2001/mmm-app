# MMM — Making Money Moves
# MMM runs fully offline; no API keys are required.
# Copy this file to .env only if you need to override a default. Never commit .env.

# Server port (defaults to 5006).
# PORT=5006

# Data directory override (defaults to %APPDATA%\mmm in the packaged app,
# server/store/money in dev).
# MMM_DATA_DIR=
