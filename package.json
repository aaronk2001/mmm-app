{
  "name": "mmm-app",
  "version": "1.0.0",
  "description": "MMM — Making Money Moves: standalone personal finance hub (Electron + Express + React)",
  "main": "electron.js",
  "scripts": {
    "dev": "concurrently \"npm run dev:react\" \"npm run dev:electron\"",
    "dev:react": "vite src -c vite.config.mjs --port 5173",
    "dev:electron": "wait-on http://localhost:5173 && electron .",
    "build": "vite build src -c vite.config.mjs",
    "start": "electron .",
    "package": "npm run build && electron-builder"
  },
  "build": {
    "appId": "com.mmm.money",
    "productName": "MMM",
    "directories": {
      "output": "build"
    },
    "asar": false,
    "win": {
      "target": "nsis"
    },
    "nsis": {
      "oneClick": true,
      "perMachine": false,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true,
      "runAfterFinish": true
    },
    "files": [
      "src/dist/**/*",
      "server/**/*",
      "electron.js",
      "preload.js",
      "package.json",
      "node_modules/**/*"
    ]
  },
  "dependencies": {
    "@anthropic-ai/sdk": "^0.36.3",
    "compression": "^1.7.4",
    "cors": "^2.8.5",
    "dotenv": "^16.4.7",
    "express": "^4.18.0",
    "express-rate-limit": "^7.4.0",
    "helmet": "^8.0.0",
    "lucide-react": "^1.8.0",
    "motion": "^12.38.0",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "recharts": "^3.8.1"
  },
  "devDependencies": {
    "@vitejs/plugin-react": "^4.0.0",
    "concurrently": "^8.2.0",
    "electron": "^30.0.0",
    "electron-builder": "^24.0.0",
    "vite": "^5.0.0",
    "wait-on": "^7.2.0"
  }
}
