{
  "name": "mmm-app",
  "version": "1.0.0",
  "private": true,
  "description": "MMM — Making Money Moves: a local-first personal-finance desktop app (Electron + Express + React + SQLite)",
  "author": "Aaron Karsten (https://github.com/aaronk2001)",
  "license": "MIT",
  "homepage": "https://github.com/aaronk2001/mmm-app#readme",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/aaronk2001/mmm-app.git"
  },
  "bugs": {
    "url": "https://github.com/aaronk2001/mmm-app/issues"
  },
  "keywords": [
    "personal-finance",
    "budgeting",
    "local-first",
    "electron",
    "sqlite",
    "backtesting",
    "react"
  ],
  "engines": {
    "node": ">=20"
  },
  "main": "electron.js",
  "scripts": {
    "dev": "concurrently \"npm run dev:react\" \"npm run dev:electron\"",
    "dev:react": "vite src -c vite.config.mjs --port 5173",
    "dev:electron": "wait-on http://localhost:5173 && electron .",
    "build": "vite build src -c vite.config.mjs",
    "start": "electron .",
    "test": "vitest run",
    "test:watch": "vitest",
    "build:portable": "node scripts/build-portable.mjs",
    "check:contrast": "node scripts/check-contrast.mjs",
    "check:learn-content": "node scripts/build-learn-index.mjs",
    "screenshots": "electron scripts/screenshots.cjs"
  },
  "dependencies": {
    "@fontsource-variable/inter": "^5.3.0",
    "@fontsource-variable/jetbrains-mono": "^5.3.0",
    "@fontsource-variable/space-grotesk": "^5.3.0",
    "@tailwindcss/vite": "^4.3.2",
    "@tanstack/react-query": "^5.101.2",
    "better-sqlite3": "^12.11.1",
    "compression": "^1.7.4",
    "cors": "^2.8.5",
    "dotenv": "^16.4.7",
    "express": "^4.18.0",
    "express-rate-limit": "^7.4.0",
    "helmet": "^8.0.0",
    "lightweight-charts": "^5.2.1",
    "lucide-react": "^1.8.0",
    "motion": "^12.38.0",
    "papaparse": "^5.5.4",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "react-grid-layout": "^1.5.3",
    "react-router-dom": "^7.18.1",
    "recharts": "^3.8.1",
    "tailwindcss": "^4.3.2",
    "ts-fsrs": "^5.4.2",
    "yahoo-finance2": "^4.0.2"
  },
  "devDependencies": {
    "@vitejs/plugin-react": "^4.0.0",
    "concurrently": "^8.2.0",
    "electron": "^30.0.0",
    "png-to-ico": "^3.0.1",
    "rcedit": "^5.0.2",
    "vite": "^5.0.0",
    "vitest": "^3.0.0",
    "wait-on": "^9.1.0"
  }
}
